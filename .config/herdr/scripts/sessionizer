#!/bin/sh
set -eu
# shellcheck source=.config/shell/projects.sh
. "${XDG_CONFIG_HOME:-$HOME/.config}/shell/projects.sh"
command -v jq >/dev/null 2>&1 || { printf 'Project picker requires jq\n' >&2; exit 1; }
herdr_bin=${HERDR_BIN_PATH:-herdr}
selected=$(project_pick) || { pick_status=$?; case $pick_status in 1|130) exit 0 ;; *) exit "$pick_status" ;; esac; }
export HERDR_BIN_PATH="$herdr_bin"
exec python3 "$(dirname -- "$0")/workspace.py" "$selected"

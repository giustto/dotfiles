#!/bin/sh
set -eu
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

case "${1:-}" in
    previous|next)
        spaces=$(yabai -m query --spaces --display)
        target=$(printf '%s' "$spaces" | jq -r --arg direction "$1" '
            sort_by(.index) | . as $spaces |
            map(."has-focus") | index(true) as $current |
            if $current == null then empty else
                $current + (if $direction == "next" then 1 else -1 end) |
                select(. >= 0 and . < ($spaces | length)) |
                $spaces[.].index
            end')
        [ -n "$target" ] || exit 0
        exec yabai -m space --focus "$target"
        ;;
    center|monitor|left|right|maximize)
        window=$(yabai -m query --windows --window)
        # Native fullscreen windows must be exited before moving or centering.
        printf '%s' "$window" | jq -e '."is-native-fullscreen" == false and ."can-move" == true' >/dev/null || exit 0
        id=$(printf '%s' "$window" | jq -r '.id')
        display=$(printf '%s' "$window" | jq -r '.display')
        if [ "$1" = monitor ]; then
            displays=$(yabai -m query --displays)
            target=$(printf '%s' "$displays" | jq -r --argjson current "$display" '
                sort_by(.index) | map(.index) | . as $ids |
                if length < 2 then empty else
                    index($current) as $i | select($i != null) |
                    $ids[($i + 1) % ($ids | length)]
                end')
            [ -n "$target" ] || exit 0
            yabai -m window "$id" --display "$target"
            yabai -m window --focus "$id"
            exit 0
        fi
        display_id=$(yabai -m query --displays --display "$display" | jq -r '.id')
        bounds=$(/usr/bin/osascript -l JavaScript "$script_dir/visible-frame.js" "$display_id")
        if [ "$1" = left ] || [ "$1" = right ] || [ "$1" = maximize ]; then
            printf '%s' "$window" | jq -e '."can-resize" == true' >/dev/null || exit 0
            if [ "$1" = maximize ]; then
                size=$(printf '%s' "$bounds" | jq -r '"abs:\(.w | floor):\(.h | floor)"')
            else
                size=$(printf '%s' "$window" | jq -r --argjson bounds "$bounds" --arg side "$1" -f "$script_dir/snap-size.jq")
            fi
            # Start at the usable origin so macOS does not clamp the new size
            # against the old position near the display's bottom/right edge.
            origin=$(printf '%s' "$bounds" | jq -r '"abs:\(.x | floor):\(.y | floor)"')
            yabai -m window "$id" --move "$origin"
            yabai -m window "$id" --resize "$size"
            [ "$1" != maximize ] || exit 0
            # Query the actual width: apps can enforce a minimum window size.
            resized=$(yabai -m query --windows --window "$id")
            position=$(printf '%s' "$resized" | jq -r --argjson bounds "$bounds" --arg side "$1" '
                (if $side == "left" then $bounds.x else
                    $bounds.x + ([$bounds.w - .frame.w, 0] | max) end | floor) as $x |
                "abs:\($x):\($bounds.y | floor)"')
            exec yabai -m window "$id" --move "$position"
        fi
        position=$(printf '%s' "$window" | jq -r --argjson bounds "$bounds" '
            "abs:\(($bounds.x + ([$bounds.w - .frame.w, 0] | max) / 2) | floor):\(($bounds.y + ([$bounds.h - .frame.h, 0] | max) / 2) | floor)"')
        exec yabai -m window "$id" --move "$position"
        ;;
    *) printf 'Usage: %s previous|next|center|monitor|left|right|maximize\n' "$0" >&2; exit 2 ;;
esac

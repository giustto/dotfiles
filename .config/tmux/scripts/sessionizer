#!/bin/sh
set -eu
# shellcheck source=.config/shell/projects.sh
. "${XDG_CONFIG_HOME:-$HOME/.config}/shell/projects.sh"
selected=$(project_pick) || { pick_status=$?; case $pick_status in 1|130) exit 0 ;; *) exit "$pick_status" ;; esac; }
name=$(project_name "$selected")
if ! tmux has-session -t "=$name" 2>/dev/null; then
  tmux new-session -d -s "$name" -c "$selected"
fi
if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "=$name"
else
  exec tmux attach-session -t "=$name"
fi
